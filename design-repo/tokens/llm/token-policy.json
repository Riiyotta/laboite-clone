  "licensedTokens": {
    "font.family.display": {
      "generatedMode": "blocked",
      "reason": "commercial typeface without a licence file in the source; generated pages use font.family.text for display titles (uppercase, 700) or a typeface the requester licenses outside this repo",
      "substitute": "font.family.text"
    }
  },
  "overrides": "Styling is owned by the section contracts; a PageSpec may only choose among the slot values above (per node) and the two page fonts. There is no free-form style field."
